/ {
    chosen {
        zephyr,console = &cdc_acm_uart0;
    };
    leds {
        compatible = "gpio-leds";

        led0: led_0 {
            gpios = <&cyw43_gpio 0 GPIO_ACTIVE_HIGH>;
            label = "LED";
        };
    };
    aliases {
        led0 = &led0;
    };
};

&i2c0 {
    status = "okay";
    bmp581: bmp581@46 {
        compatible = "bosch,bmp581";
        reg = <0x46>;
        int-gpios = <&gpio0 19 GPIO_ACTIVE_HIGH>;
        label = "BMP581";
    };
    bmi270: bmi270@68 {
        compatible = "bosch,bmi270";
        reg = <0x68>;
        irq-gpios = <&gpio0 22 GPIO_ACTIVE_HIGH>;
        label = "BMI270";
    };
};

&zephyr_udc0 {
    cdc_acm_uart0: cdc_acm_uart0 {
        compatible = "zephyr,cdc-acm-uart";
    };
};

